<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Common.Secrets</PackageId>
    <Version>1.2.0</Version>
    <Authors>Fitzroy Wright</Authors>
    <Description>Reusable secret-provider abstractions with configurable per-application provider ordering, including Bitwarden and OpenBao.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/fitzroywright/Common.Secrets</RepositoryUrl>
    <CommonDiagnosticsProject Condition="Exists('../Common.Diagnostics/Common.Diagnostics.csproj')">../Common.Diagnostics/Common.Diagnostics.csproj</CommonDiagnosticsProject>
    <CommonDiagnosticsProject Condition="'$(CommonDiagnosticsProject)' == '' and Exists('Common.Diagnostics/Common.Diagnostics.csproj')">Common.Diagnostics/Common.Diagnostics.csproj</CommonDiagnosticsProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Common.Secrets.Tests/**/*.cs" />
    <Compile Remove="Common.Diagnostics/**/*.cs" />
    <EmbeddedResource Remove="Common.Secrets.Tests/**" />
    <None Remove="Common.Secrets.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(CommonDiagnosticsProject)' != ''">
    <ProjectReference Include="$(CommonDiagnosticsProject)" />
  </ItemGroup>
  <Target Name="RequireCommonDiagnostics" BeforeTargets="PrepareForBuild" Condition="'$(CommonDiagnosticsProject)' == ''">
    <Error Text="Common.Diagnostics project was not found. Clone Common.Diagnostics beside Common.Secrets or into Common.Secrets/Common.Diagnostics." />
  </Target>
</Project>
